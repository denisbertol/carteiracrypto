# Ambiente de execução (development, test, production)
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Conexão PostgreSQL (Papel runtime com privilégios restritos e RLS)
DATABASE_URL=postgresql://carteira_app:senha_segura@db.exemplo.supabase.co:5432/postgres?sslmode=require

# Conexão Administrativa para Migrações (Usada apenas pelo runner de migração)
MIGRATION_DATABASE_URL=postgresql://postgres:senha_admin@db.exemplo.supabase.co:5432/postgres?sslmode=require

# Autenticação Nativa (JWT e Google OAuth)
SECRET_KEY=sua-chave-secreta-longa-e-aleatoria-para-jwt
OWNER_EMAIL=denisbertol@gmail.com
OWNER_PASSWORD=sua-senha-pessoal
OWNER_USER_ID=ee959f12-1c54-488e-98e4-110891645550

# Google OAuth (Obtido em console.cloud.google.com -> Credenciais -> ID do cliente OAuth)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# unavailable (seguro por padrão), coingecko, fixture ou mock_stale (só development/test)
QUOTE_MODE=unavailable
DEMO_QUOTE_USD=180
# Chave somente no servidor; nunca enviar ao navegador ou incluir em logs.
COINGECKO_DEMO_API_KEY=
# Confirmar quota/janela no painel da conta. Sem chave/janela vigente: indisponível.
# Contador deve incluir preços, catálogo e tentativas que falharam.
COINGECKO_CALL_LIMIT=10000
# Descomentar ambos e substituir pela janela real da chave, incluindo timezone.
# COINGECKO_WINDOW_START=2026-09-01T00:00:00Z
# COINGECKO_WINDOW_END=2026-10-01T00:00:00Z
# Cadência 300 s, lease 60 s, catálogo 24 h e retenção 30 dias são constantes.

# Limites e Pool de Conexões
POOL_MIN_SIZE=1
POOL_MAX_SIZE=3
POOL_TIMEOUT_SECONDS=2.0
LOCK_TIMEOUT_SECONDS=2.0
STATEMENT_TIMEOUT_SECONDS=5.0
